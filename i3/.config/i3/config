# ╔══════════════════════════════════════════════════════════╗
# ║           i3 config — Catppuccin Mocha                   ║
# ╚══════════════════════════════════════════════════════════╝

set $mod Mod4

# ── Catppuccin Mocha Palette ──────────────────────────────────────────────────
set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# ── Font ──────────────────────────────────────────────────────────────────────
font pango:JetBrainsMono Nerd Font 10

# ── Window Colors ─────────────────────────────────────────────────────────────
#                         border     background  text       indicator  child_border
client.focused            $mauve     $base       $text      $mauve     $mauve
client.focused_inactive   $surface1  $base       $subtext1  $overlay0  $surface1
client.unfocused          $surface0  $base       $overlay1  $surface0  $surface0
client.urgent             $red       $red        $base      $red       $red
client.placeholder        $surface0  $base       $overlay1  $overlay0  $surface0
client.background         $base

# ── Layout & Gaps ─────────────────────────────────────────────────────────────
gaps inner 4
gaps outer 4
smart_gaps on

default_border pixel 4
default_floating_border pixel 4
hide_edge_borders smart

# ── Startup ───────────────────────────────────────────────────────────────────
exec --no-startup-id setxkbmap us,ua -option grp:alt_shift_toggle
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id ~/.config/i3/scripts/monitors.sh
# Lock after 10 min idle (X screensaver → xss-lock → i3lock) and on suspend
exec --no-startup-id xset s 600 600
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --color=1e1e2e --nofork
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id sh -c '[ "$DISPLAY" = ":1" ] || picom --daemon'
exec_always --no-startup-id feh --bg-scale ~/Pictures/duesenberg.jpg
# Chat apps start at login and land on 5: chat (not in the VNC session on :1)
exec --no-startup-id sh -c '[ "$DISPLAY" = ":1" ] || telegram-desktop -startintray'
exec --no-startup-id sh -c '[ "$DISPLAY" = ":1" ] || discord --start-minimized'
# Reopen the terminals of tmux sessions on their workspaces after a reboot,
# then keep recording the layout every minute (scripts/sessions.py)
exec --no-startup-id sh -c '[ "$DISPLAY" = ":1" ] || ~/.config/i3/scripts/sessions.py run'

# ── Mouse ─────────────────────────────────────────────────────────────────────
floating_modifier $mod
tiling_drag modifier titlebar
focus_follows_mouse no

# ── Workspaces ────────────────────────────────────────────────────────────────
# Fixed map: 1-3 development, 4+ everything else. Win+N still works by number.
set $ws1  "1: dev"
set $ws2  "2: dev"
set $ws3  "3: ref"
set $ws4  "4: web"
set $ws5  "5: chat"
set $ws6  "6: media"
set $ws7  "7: eda"
set $ws8  "8"
set $ws9  "9"
set $ws10 "10"

# Monitor per workspace: VGA | DP (main, 1440p) | laptop.
# Each line lists fallbacks: output names shift when the Intel/NVIDIA cards
# enumerate in a different order (LVDS-1 vs LVDS-2, VGA-1-2 vs VGA-1-1).
# Outputs that aren't present are skipped, so undocked or over VNC
# everything opens on the one screen.
set $mon_main   DP-1-1 DP-1-2 DP-1-3 primary
set $mon_left   VGA-1-1 VGA-1-2 DP-1-1 primary
set $mon_laptop LVDS-1 LVDS-2 primary
workspace $ws1 output $mon_main
workspace $ws2 output $mon_left
workspace $ws3 output $mon_laptop
workspace $ws4 output $mon_main
workspace $ws5 output $mon_laptop
workspace $ws6 output $mon_left
workspace $ws7 output $mon_main

# Win+N on the workspace you're already on jumps back to the previous one
workspace_auto_back_and_forth yes
#: Back to the previous workspace
bindsym $mod+Escape workspace back_and_forth

# ── App → workspace ───────────────────────────────────────────────────────────
# Find a window's class with: xprop WM_CLASS (then click the window)
# Firefox is used for both dev and personal browsing, so it isn't assigned.
assign [class="(?i)^telegramdesktop$"]          number $ws5
assign [class="(?i)^discord$"]                  number $ws5
assign [class="(?i)^thunderbird"]               number $ws5
for_window [workspace="^5: chat$"]              layout tabbed
assign [class="(?i)^(mpv|vlc)$"]                number $ws6
# Spotify sets its class after mapping, so assign misses it
for_window [class="(?i)^spotify$"]              move container to workspace number $ws6
assign [class="(?i)^(kicad|eeschema|pcbnew|gerbview)$"] number $ws7
assign [class="(?i)stm32cube|microxplorer"]     number $ws7

# ── Applications ──────────────────────────────────────────────────────────────
#: Terminal
bindsym $mod+Return  exec --no-startup-id ~/.config/i3/scripts/term.sh
#: Close window
bindsym $mod+Shift+q kill
#: App launcher (rofi)
bindsym $mod+d       exec --no-startup-id rofi -show drun
#: Window switcher (rofi)
bindsym $mod+Tab     exec --no-startup-id rofi -show window

# Project picker → tmux dev workspace (dev-lite default / dev-claude full layout)
# Running sessions are listed first; Alt+c in the picker = claude --continue
#: Project picker → dev-lite (Claude + shell)
bindsym $mod+p       exec --no-startup-id ~/.config/i3/scripts/dev-picker.sh lite
#: Project picker → full layout (nvim + shell + Claude)
bindsym $mod+Shift+p exec --no-startup-id ~/.config/i3/scripts/dev-picker.sh claude

# Obsidian as a scratchpad overlay + quick capture to 99_Input/Inbox.md
for_window [class="obsidian"] move scratchpad, resize set 85 ppt 85 ppt, move position center
#: Obsidian overlay
bindsym $mod+o exec --no-startup-id ~/.config/i3/scripts/obsidian-toggle.py
#: Quick capture to the Obsidian inbox
bindsym $mod+n exec --no-startup-id ~/.config/i3/scripts/quick-capture.sh

# VimCommander (two-pane file manager)
#: VimCommander
bindsym $mod+c exec --no-startup-id ~/.local/bin/vimcommander

#: Lock screen
bindsym $mod+Shift+x exec --no-startup-id i3lock --color=1e1e2e
#: Bluetooth menu
bindsym $mod+F8       exec --no-startup-id ~/.config/i3/scripts/rofi-bluetooth.sh
#: Toggle keyboard layout
bindsym $mod+grave    exec --no-startup-id ~/.config/i3/scripts/toggle-kbd.py
#: Screenshot: select area (flameshot)
bindsym Print            exec --no-startup-id flameshot gui
#: Screenshot: whole screen
bindsym $mod+Print       exec --no-startup-id flameshot screen
# Re-apply the monitor layout after plugging monitors in or out
#: Re-apply monitor layout
bindsym $mod+Shift+m exec --no-startup-id ~/.config/i3/scripts/monitors.sh

# ── Focus ─────────────────────────────────────────────────────────────────────
bindsym $mod+h     focus left
bindsym $mod+j     focus down
bindsym $mod+k     focus up
bindsym $mod+l     focus right

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# ── Move ──────────────────────────────────────────────────────────────────────
bindsym $mod+Shift+h     move left
bindsym $mod+Shift+j     move down
bindsym $mod+Shift+k     move up
bindsym $mod+Shift+l     move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# ── Splits ────────────────────────────────────────────────────────────────────
#: Next window opens to the right
bindsym $mod+b split h
#: Next window opens below
bindsym $mod+v split v

# ── Layout ────────────────────────────────────────────────────────────────────
bindsym $mod+f         fullscreen toggle
#: Stacked layout
bindsym $mod+s         layout stacking
#: Tabbed layout
bindsym $mod+w         layout tabbed
#: Toggle split direction
bindsym $mod+e         layout toggle split
#: Float / unfloat window
bindsym $mod+Shift+space floating toggle
#: Focus floating ↔ tiled
bindsym $mod+space     focus mode_toggle
#: Focus parent container
bindsym $mod+a         focus parent

# ── Workspace Switching ───────────────────────────────────────────────────────
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# ── Move to Workspace ─────────────────────────────────────────────────────────
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# ── Brightness ────────────────────────────────────────────────────────────────
#: Brightness up
bindsym XF86MonBrightnessUp   exec --no-startup-id xbacklight -inc 5
#: Brightness down
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 5

# ── Volume ────────────────────────────────────────────────────────────────────
set $refresh_i3status killall -SIGUSR1 i3status
#: Volume up
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@   +5%    && $refresh_i3status
#: Volume down
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@   -5%    && $refresh_i3status
#: Mute
bindsym XF86AudioMute        exec --no-startup-id pactl set-sink-mute   @DEFAULT_SINK@   toggle && $refresh_i3status
#: Mute microphone
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# ── Scratchpad ────────────────────────────────────────────────────────────────
#: Show / hide scratchpad
bindsym $mod+minus       scratchpad show
#: Move window to scratchpad
bindsym $mod+Shift+minus move scratchpad

# ── i3 Control ────────────────────────────────────────────────────────────────
#: Reload i3 config
bindsym $mod+Shift+c reload
#: Restart i3 in place
bindsym $mod+Shift+r restart
#: Exit i3 (asks first)
bindsym $mod+Shift+e exec "i3-nagbar -t warning \
    -m 'Exit i3 and end your X session?' \
    -B 'Yes, exit i3' 'i3-msg exit'"

# ── Resize Mode ───────────────────────────────────────────────────────────────
mode "  resize  " {
    bindsym h resize shrink width  10 px or 10 ppt
    bindsym j resize grow   height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow   width  10 px or 10 ppt

    bindsym Left  resize shrink width  10 px or 10 ppt
    bindsym Down  resize grow   height 10 px or 10 ppt
    bindsym Up    resize shrink height 10 px or 10 ppt
    bindsym Right resize grow   width  10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
#: Resize mode (hjkl / arrows, Esc to leave)
bindsym $mod+r mode "  resize  "

# ── Bar ───────────────────────────────────────────────────────────────────────
bar {
    status_command ~/.config/i3/scripts/i3status-bt.py
    position top
    tray_output primary
    separator_symbol "  |  "

    font pango:JetBrainsMono Nerd Font 10

    colors {
        background         $mantle
        statusline         $text
        separator          $overlay0

        #                    border     background  text
        focused_workspace    $mauve     $mauve      $base
        active_workspace     $surface1  $surface1   $text
        inactive_workspace   $mantle    $mantle     $overlay1
        urgent_workspace     $red       $red        $base
        binding_mode         $peach     $peach      $base
    }
}
# ── Extras ──────────────────────────────────────────────────────────────────
# Google Drive (personal + optional shared drive; script clears stale mounts)
exec --no-startup-id ~/.config/i3/scripts/mount-gdrive.sh

#: Unmount Google Drive
bindsym $mod+F9  exec --no-startup-id fusermount -u ~/GoogleDrive
#: Mount Google Drive
bindsym $mod+F10 exec --no-startup-id ~/.config/i3/scripts/mount-gdrive.sh

# Key cheat sheet: search every i3 + tmux binding, Enter runs an i3 one
#: Key cheat sheet (Enter runs it)
bindsym $mod+slash exec --no-startup-id ~/.local/bin/keys --rofi
#: Key cheat sheet (VNC; Ctrl+Alt+/ is swallowed by TigerVNC)
bindsym Ctrl+Mod1+k exec --no-startup-id ~/.local/bin/keys --rofi
# Count binding use for `keys stats` (one logger per i3, survives restarts)
exec_always --no-startup-id ~/.local/bin/keys i3-log

# ── VNC fallbacks ───────────────────────────────────────────────────────────
# The Win key is grabbed by the VNC client's host, so Ctrl+Alt stands in for it
#: Terminal (VNC)
bindsym Ctrl+Mod1+Return exec --no-startup-id ~/.config/i3/scripts/term.sh
#: App launcher (VNC)
bindsym Ctrl+Mod1+d      exec --no-startup-id rofi -show drun
#: Close window (VNC)
bindsym Ctrl+Mod1+q      kill
#: Project picker → dev-lite (VNC)
bindsym Ctrl+Mod1+p      exec --no-startup-id ~/.config/i3/scripts/dev-picker.sh lite
#: Project picker → full layout (VNC)
bindsym Ctrl+Mod1+Shift+p exec --no-startup-id ~/.config/i3/scripts/dev-picker.sh claude
#: Obsidian overlay (VNC)
bindsym Ctrl+Mod1+o      exec --no-startup-id ~/.config/i3/scripts/obsidian-toggle.py
