# ThinkPad: charge the battery to 80 %, start again below 75 % (mostly docked:
# a battery kept at 100 % wears faster). End before start: start must stay < end.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT0", \
  ATTR{charge_control_end_threshold}="80", ATTR{charge_control_start_threshold}="75"
