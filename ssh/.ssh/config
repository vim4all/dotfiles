# Generic SSH defaults (public repo: no hosts, users or IPs here).
# Your own hosts go in ~/.ssh/config.local, created by ./install.sh.
# ssh uses the FIRST value it finds, so the local file comes first and can
# override anything below.
Include config.local

Host *
    # Reuse one connection per host: repeat ssh / scp / rsync / git start instantly
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m
    # Keep idle sessions alive through NAT, Wi-Fi and Tailscale
    ServerAliveInterval 30
    ServerAliveCountMax 3
    AddKeysToAgent yes
    HashKnownHosts no
